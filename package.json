{
  "name": "sdzf-music-program",
  "description": "monorepo for SDZF Music Program",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "turbo dev --filter=frontend",
    "dev:studio": "turbo dev --filter=studio --ui=tui",
    "build": "turbo run build",
    "format": "prettier --write .",
    "lint": "oxlint  --fix"
  },
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "turbo": "^2.10.12"
  }
}
